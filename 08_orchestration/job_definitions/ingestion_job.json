{
  "name": "Meridian - API Ingestion Job",
  "tasks": [
    {
      "task_key": "api_ingestion",
      "description": "Ingest data from APIs every 15 minutes",
      "notebook_task": {
        "notebook_path": "/Repos/prashant.agrawal100@gmail.com/meridian-financial-lakehouse/02_ingestion/api_ingest_raw",
        "source": "GIT"
      },
      "job_cluster_key": "default_cluster"
    }
  ],
  "job_clusters": [
    {
      "job_cluster_key": "default_cluster",
      "new_cluster": {
        "spark_version": "14.3.x-scala2.12",
        "node_type_id": "i3.xlarge",
        "num_workers": 2
      }
    }
  ],
  "schedule": {
    "quartz_cron_expression": "0 */15 * * * ?",
    "timezone_id": "UTC"
  },
  "email_notifications": {
    "on_failure": ["your-email@example.com"]
  },
  "max_concurrent_runs": 1
}
